# ---------- Supabase ----------
# 本地：执行  pnpm db:start  然后  pnpm db:env  自动写入 .env.local
# 云端：Supabase 控制台 Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 认证 ----------
# 账号是手机号：注册/登录用手机号 + 密码，不做短信验证码，
# 内部把手机号映射成 <手机号>@<域名> 的邮箱交给 Supabase Auth（见 lib/env.ts 的 phoneToEmail）
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=campus.local

# ---------- AI ----------
# 整套 AI 能力只用一个「视觉多模态模型」：拍照后识别物品名称与描述，
# 并给出「通过 / 建议补拍」建议，因此只配一个 AI_MODEL。
# 经 Vercel AI SDK 以 OpenAI 兼容协议接入，DeepSeek / DashScope 兼容模式 / 智谱均适用。
#
#   AI_PROVIDER=mock    完全确定性、零网络（默认，开发与自动化测试用）
#   AI_PROVIDER=ai-sdk  接入真实模型，此时 AI_API_KEY 与 AI_MODEL 必填
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
# 留空则用 https://api.deepseek.com/v1（见 lib/ai/ai-sdk.ts）；接入其他供应商时填其兼容端点，例如
#   DeepSeek：            https://api.deepseek.com/v1
#   DashScope 兼容模式：  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱：                https://open.bigmodel.cn/api/paas/v4
AI_BASE_URL=
#
# 【当前配置】DeepSeek deepseek-flash（input_modalities 含 image）
#   AI_PROVIDER=ai-sdk
#   AI_MODEL=deepseek-flash
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_API_KEY=<你的 DeepSeek API Key>
#
# 该模型是推理模型，lib/ai/ai-sdk.ts 里已按实测结论固定：
#   reasoning_effort=low   —— high 档在结构化抽取上会崩坏（title 变乱码、字段混入 base64）
#   maxOutputTokens=16000  —— 给小了会被 reasoning 吃光并返回空 content
#   关掉结构化输出         —— DeepSeek 不支持 response_format: json_schema，走提示词 + JSON 模式
#   单次请求 60s 硬超时    —— 否则模型端挂起会让全屏加载一直转
#
# 离线测试与 E2E 会强制 AI_PROVIDER=mock（见 tests/setup.ts 与 playwright.config.ts），
# 真实模型只用于 pnpm test:live 与手工验证。

# ---------- 运行期参数 ----------
# 照片上限/分页条数/认领与 AI 调用限流阈值位于数据库 app_config 表
# （唯一真源；RPC 强制执行，不接受调用方传入）
# 修改方式：UPDATE public.app_config SET ... ; 或写一条新迁移
